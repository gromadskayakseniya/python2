n = int(input("Введите число: "))
a = list(map(int, input("Введите список: ").split()))

if n == 1:
    print(*a)
else:
    possible_max = set()
    
    for i in range(n):
        if i == 0:
            new_max = max(a[1:])
        elif i == n - 1:
            new_max = max(a[:n-1])
        else:
            new_max = max(a[:i] + a[i+1:])
        possible_max.add(new_max)
    
    print(*sorted(possible_max))
