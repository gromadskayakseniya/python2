n = int(input("Введите число: "))
a = list(map(int, input("Введите список: ").split()))

def is_stable(lst):
    for i in range(1, len(lst) - 1):
        if not (min(lst[i-1], lst[i+1]) <= lst[i] <= max(lst[i-1], lst[i+1])):
            return False
    return True

if is_stable(a):
    print("Да")
else:
    possible = False
    for i in range(n):
        new_a = a[:i] + a[i+1:]
        if len(new_a) >= 2 and is_stable(new_a):
            possible = True
            break
        elif len(new_a) < 2:
            possible = True
            break
    print("Да" if possible else "Нет")
