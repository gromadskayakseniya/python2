n = int(input("Введите число: "))
a = list(map(int, input("Введите список: ").split()))

if n <= 1:
    print(n)
else:
    max_len = 1
    cur_len = 1
    
    for i in range(1, n):
        if abs(a[i] - a[i-1]) == 1:
            cur_len += 1
            max_len = max(max_len, cur_len)
        else:
            cur_len = 1
    
    print(max_len)
