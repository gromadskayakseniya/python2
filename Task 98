n = int(input("Введите число: "))
a = list(map(int, input("Введите список: ").split()))

found = False

for i in range(n):
    for j in range(i + 1, n):
        if a[i] == a[j]:
            middle = a[i+1:j]
            if len(middle) == len(set(middle)):
                found = True
                break
    if found:
        break

print("Да" if found else "Нет")
