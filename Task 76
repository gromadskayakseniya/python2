n = int(input("Введите число: "))
a = list(map(int, input("Введите список: ").split()))

max_len = 0
seen = set()
left = 0

for right in range(n):
    while a[right] in seen:
        seen.remove(a[left])
        left += 1
    seen.add(a[right])
    max_len = max(max_len, right - left + 1)

print(max_len)
